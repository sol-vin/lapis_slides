[11.38, "o", "\u001b[H\u001b[1;37;44m \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557 \u001b[0m\r\n\u001b[1;37;44m \u2551 LAPIS NATIVE DEBUGGER & REVERSE ENGINEERING STUDIO (cradare2)                    \u2551 \u001b[0m\r\n\u001b[1;37;44m \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d \u001b[0m\r\n \u001b[2;37m [1] Disassembly (pdf) \u001b[0m \u001b[1;30;46m [2] Pseudo-C (pdc) \u001b[0m \u001b[2;37m [3] Crystal Source (cl) \u001b[0m \u001b[2;37m [4] Registers (dr) \u001b[0m \u001b[2;37m [5] Hex Memory (px) \u001b[0m \u001b[2;37m [6] Call Stack (dbt) \u001b[0m \u001b[2;37m [7] Binary Metrics \u001b[0m \r\n\u001b[36m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[1;33m// Decompiled Pseudo-C (pdc) via radare2 cradare2 engine:\u001b[0m\r\n\u001b[32mvoid\u001b[0m \u001b[1mPlayer__physics_process\u001b[0m(\u001b[36mPlayer*\u001b[0m this, \u001b[32mdouble\u001b[0m delta) {\r\n    \u001b[35m// Vector3 velocity calculation\u001b[0m\r\n    this->velocity.y -= \u001b[33m9.80665\u001b[0m * delta;\r\n    \r\n    \u001b[35m// GDExtension C-ABI direct virtual dispatch\u001b[0m\r\n    \u001b[1mCharacterBody3D_move_and_slide\u001b[0m((\u001b[36mCharacterBody3D*\u001b[0m)this);\r\n    \r\n    \u001b[35m// Jump impulse triggering\u001b[0m\r\n    \u001b[32mif\u001b[0m (this->is_on_floor && \u001b[1mInput_is_action_just_pressed\u001b[0m(\u001b[33m\"jump\"\u001b[0m)) {\r\n        this->velocity.y = \u001b[33m4.50000\u001b[0m;\r\n    }\r\n}\r\n\r\n\u001b[2m [1-7] Tabs  [e] Export C file  [b] Set Breakpoint  [q] Exit\u001b[0m"]
[17.38, "o", "\u001b[H\u001b[1;37;44m \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557 \u001b[0m\r\n\u001b[1;37;44m \u2551 LAPIS NATIVE DEBUGGER & REVERSE ENGINEERING STUDIO (cradare2)                    \u2551 \u001b[0m\r\n\u001b[1;37;44m \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d \u001b[0m\r\n \u001b[2;37m [1] Disassembly (pdf) \u001b[0m \u001b[2;37m [2] Pseudo-C (pdc) \u001b[0m \u001b[1;30;46m [3] Crystal Source (cl) \u001b[0m \u001b[2;37m [4] Registers (dr) \u001b[0m \u001b[2;37m [5] Hex Memory (px) \u001b[0m \u001b[2;37m [6] Call Stack (dbt) \u001b[0m \u001b[2;37m [7] Binary Metrics \u001b[0m \r\n\u001b[36m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\