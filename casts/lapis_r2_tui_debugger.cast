00\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[1;33m; -- sym.Player__physics_process (rip=0x14001a420):\u001b[0m\r\n\u001b[36m0x14001a420\u001b[0m  \u001b[32m55\u001b[0m                    \u001b[1mpush\u001b[0m rbp\r\n\u001b[36m0x14001a421\u001b[0m  \u001b[32m4889e5\u001b[0m                \u001b[1mmov\u001b[0m rbp, rsp\r\n\u001b[36m0x14001a424\u001b[0m  \u001b[32m4883ec40\u001b[0m              \u001b[1msub\u001b[0m rsp, 0x40\r\n\u001b[36m0x14001a428\u001b[0m  \u001b[32m48894d10\u001b[0m              \u001b[1mmov\u001b[0m qword [rbp - 0x10], rcx\r\n\u001b[36m0x14001a42c\u001b[0m  \u001b[32mf20f104138\u001b[0m            \u001b[1mmovsd\u001b[0m xmm0, qword [rcx + 0x38]  \u001b[35m; Player#velocity.y\u001b[0m\r\n\u001b[36m0x14001a432\u001b[0m  \u001b[32mf20f5c0520420000\u001b[0m      \u001b[1msubsd\u001b[0m xmm0, qword [rip + 0x4220] \u001b[35m; GRAVITY * delta\u001b[0m\r\n\u001b[36m0x14001a43a\u001b[0m  \u001b[32mf20f114138\u001b[0m            \u001b[1mmovsd\u001b[0m qword [rcx + 0x38], xmm0\r\n\u001b[36m0x14001a440\u001b[0m  \u001b[32me87b120000\u001b[0m              \u001b[1mcall\u001b[0m sym.CharacterBody3D_move_and_slide\r\n\u001b[36m0x14001a445\u001b[0m  \u001b[32m488b4d10\u001b[0m              \u001b[1mmov\u001b[0m rcx, qword [rbp - 0x10]\r\n\u001b[36m0x14001a449\u001b[0m  \u001b[32m80794801\u001b[0m              \u001b[1mcmp\u001b[0m byte [rcx + 0x48], 1      \u001b[35m; on_floor?\u001b[0m\r\n\u001b[36m0x14001a44d\u001b[0m  \u001b[32m7512\u001b[0m                  \u001b[1mjne\u001b[0m 0x14001a461\r\n\r\n\u001b[2m [1-7] Tabs  [n] Next Instruction  [s] Step Into  [c] Continue  [q] Exit\u001b[0m"]
