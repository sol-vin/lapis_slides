[11.005, "o", "\u001b[1;36m[Lapis Docs]\u001b[0m Looking up Godot ClassDB symbol: \u001b[1;33mCharacterBody3D.move_and_slide\u001b[0m\r\n"]
[11.065, "o", "\r\n"]
[11.125, "o", "\u001b[1;32mbool CharacterBody3D.move_and_slide()\u001b[0m\r\n"]
[11.185, "o", "  Moves the body based on \u001b[36mvelocity\u001b[0m. If the body collides with another,\r\n"]
[11.245, "o", "  it will slide along the other body rather than stop immediately.\r\n"]
[11.305, "o", "\r\n"]
[11.365, "o", "\u001b[1;34mCrystal Signature (LibGodot):\u001b[0m\r\n"]
[11.425, "o", "  \u001b[35mdef move_and_slide : Bool\u001b[0m\r\n"]
[11.485, "o", "    \u001b[90m# Direct C ABI virtual call with zero marshalling allocation\u001b[0m\r\n"]
[11.545, "o", "    LibGodot.character_body_3d_move_and_slide(to_unsafe)\r\n"]
[11.605, "o", "  \u001b[35mend\u001b[0m\r\n"]
[11.665, "o", "\r\n"]
[11.725, "o", "\u001b[90mPress 'q' or Esc to exit offline doc viewer\u001b[0m\r\n"]
