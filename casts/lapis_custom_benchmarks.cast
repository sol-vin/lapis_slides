[1.312, "o", "\r\n\u001b[1;37mRegistered Benchmarks in ~/lapis/template/benchmarks (5 total):\u001b[0m\r\n  \u001b[1;36mPathfindingCrowd\u001b[0m     \u001b[33m[Group: Engine ]\u001b[0m A* routing throughput (5,000 active agents)\r\n    \u001b[90m\u2022\u001b[0m \u001b[32mCrystal (AVX2 SIMD)\u001b[0m  \u001b[90m\u2022\u001b[0m \u001b[37mGDScript (Baseline)\u001b[0m\r\n  \u001b[1;36mProceduralDungeon\u001b[0m    \u001b[35m[Custom: Compute]\u001b[0m BSP room partitioning & corridor generator\r\n  \u001b[1;36mCombatRadarScan\u001b[0m      \u001b[33m[Custom: Engine ]\u001b[0m QuadTree spatial query (1,200 entities)\r\n  \u001b[1;36mParticleBatchSim\u001b[0m     \u001b[35m[Custom: Compute]\u001b[0m 20,000 Verlet integration physics steps\r\n  \u001b[1;36mInventoryPacker\u001b[0m      \u001b[34m[Custom: Systems]\u001b[0m Binary buffer serialization & delta sync\r\n"]
