[18.084, "o", "\r\n\u001b[1;37m=== Lapis Benchmark Suite: Category 'compute' (4 cases) ===\u001b[0m\r\n  \u001b[32m\u2714\u001b[0m \u001b[1mParticleBatchSim\u001b[0m     (20k particles)   \u001b[32m2.15 ms\u001b[0m  (GDScript: 38.70 ms) -> \u001b[1;32m18.0x\u001b[0m\r\n  \u001b[32m\u2714\u001b[0m \u001b[1mProceduralDungeon\u001b[0m    (BSP 50 rooms)    \u001b[32m1.42 ms\u001b[0m  (GDScript: 24.10 ms) -> \u001b[1;32m17.0x\u001b[0m\r\n  \u001b[32m\u2714\u001b[0m \u001b[1mCombatRadarScan\u001b[0m      (1.2k entities)   \u001b[32m0.38 ms\u001b[0m  (GDScript:  5.89 ms) -> \u001b[1;32m15.5x\u001b[0m\r\n  \u001b[32m\u2714\u001b[0m \u001b[1mPathfindingCrowd\u001b[0m     (5k agents)       \u001b[32m0.82 ms\u001b[0m  (GDScript: 12.63 ms) -> \u001b[1;32m15.4x\u001b[0m\r\n\r\n  \u001b[1;36m\ud83d\udcca Speedup Factor (x) - Higher is Faster:\u001b[0m\r\n  ParticleBatchSim    [\u001b[36m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m] \u001b[1;32m18.0x\u001b[0m\r\n  ProceduralDungeon   [\u001b[36m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588    \u001b[0m] \u001b[1;32m17.0x\u001b[0m\r\n  CombatRadarScan     [\u001b[36m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588          \u001b[0m] \u001b[1;32m15.5x\u001b[0m\r\n  PathfindingCrowd    [\u001b[36m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588          \u001b[0m] \u001b[1;32m15.4x\u001b[0m\r\n\r\n  \u001b[1mGeoMean Speedup:\u001b[0m  \u001b[1;36m16.4x faster\u001b[0m across compute suite\r\n  \u001b[32m\u2714\u001b[0m Saved SVG chart: \u001b[36mreports/benchmarks/benchmark_chart.svg\u001b[0m\r\n  \u001b[32m\u2714\u001b[0m HTML Report:     \u001b[36mreports/benchmarks/benchmark_report.html\u001b[0m\r\n"]
