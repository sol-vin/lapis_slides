[10.762, "o", "\u001b[1;37mBenchmark Results: PathfindingCrowd (5,000 Agents)\u001b[0m\r\n\u001b[36m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\r\n\u001b[36m\u2502\u001b[0m \u001b[1mImplementation\u001b[0m               \u001b[36m\u2502\u001b[0m \u001b[1mMedian Time\u001b[0m \u001b[36m\u2502\u001b[0m \u001b[1mThroughput\u001b[0m   \u001b[36m\u2502\u001b[0m \u001b[1mSpeedup\u001b[0m   \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m\r\n\u001b[36m\u2502\u001b[0m \u001b[1;32mCrystal (SIMD AVX2)\u001b[0m          \u001b[36m\u2502\u001b[0m     \u001b[32m0.82 ms\u001b[0m \u001b[36m\u2502\u001b[0m 6,097 agt/fr \u001b[36m\u2502\u001b[0m \u001b[1;32m15.4x \ud83d\ude80\u001b[0m  \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m GDScript (Baseline)          \u001b[36m\u2502\u001b[0m    12.63 ms \u001b[36m\u2502\u001b[0m   395 agt/fr \u001b[36m\u2502\u001b[0m 1.0x (ref) \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n  \u001b[1mGeoMean Speedup:\u001b[0m  \u001b[1;36m15.4x faster\u001b[0m (Crystal vs GDScript)\r\n  \u001b[1mHeap Allocation:\u001b[0m  \u001b[1;32m0 bytes/frame\u001b[0m (Zero-Alloc Invariant Verified)\r\n"]
