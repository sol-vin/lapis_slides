[10.116, "o", "\r\n\u001b[1;37m=== Documentation Search Results for 'concurrency' (6 matches) ===\u001b[0m\r\n  \u001b[33m[GUIDE]\u001b[0m  \u001b[1mguide:concurrency:A_FIBERS_AND_COOPERATIVE_AWAIT\u001b[0m \u2014 Fibers & Await\r\n  \u001b[33m[GUIDE]\u001b[0m  \u001b[1mguide:concurrency:B_OS_THREADS_AND_CHANNELS\u001b[0m \u2014 Multi-core Threads\r\n  \u001b[33m[GUIDE]\u001b[0m  \u001b[1mguide:concurrency:C_MAIN_THREAD_DISPATCH\u001b[0m \u2014 Main Queue Dispatch\r\n  \u001b[35m[STDLIB]\u001b[0m \u001b[1mChannel(T)\u001b[0m \u2014 Concurrent communication conduit between fibers\r\n  \u001b[35m[STDLIB]\u001b[0m \u001b[1mMutex\u001b[0m \u2014 Re-entrant mutual exclusion primitive for worker threads\r\n  \u001b[32m[CRYSTAL]\u001b[0m\u001b[1mWorkerPool\u001b[0m \u2014 Background task scheduler and fiber pool\r\n"]
