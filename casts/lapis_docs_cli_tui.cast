[18.504, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[1;37;48;5;238m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[90m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[36mSearch: [concurrency] (Press '/' to search)\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (6 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;33m[Lapis Architectural Guide]\u001b[0m \u001b[1mguide:concurrency:fibers\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:fibers\u001b[0m \u001b[90m\u2502\u001b[0m \u001b[90mDefined in: docs/d_architecture/a_concurrency.cr:14\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:threads \u001b[90m\u2502\u001b[0m \r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:dispatch \u001b[90m\u2502\u001b[0m \u001b[1mSIGNATURE:\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Channel(T)          \u001b[90m\u2502\u001b[0m   \u001b[1;32;48;5;235mGuide [concurrency]: Fibers & Cooperative Await\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m \r\n  \u001b[32m[CR:CLASS]\u001b[0m WorkerPool          \u001b[90m\u2502\u001b[0m \u001b[1mDESCRIPTION:\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m Comprehensive guide to running Crystal fibers in Godot's\r\n                                    \u001b[90m\u2502\u001b[0m single-threaded scene loop and cooperative yielding.\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[1;37m### The Three Golden Fiber Invariants\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m 1. Never call blocking sleep on the main thread.\r\n                                    \u001b[90m\u2502\u001b[0m 2. Always cooperatively yield or await engine frames.\r\n                                    \u001b[90m\u2502\u001b[0m 3. Route UI and SceneTree operations to main thread.\r\n                                    \u001b[90m\u2502\u001b[0m \u001b[90m[PgDn: Scroll for Code Examples \u2193]\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
[20.704, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[1;37;48;5;238m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[90m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[36mSearch: [concurrency] (Press '/' to search)\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (6 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;33m[Lapis Architectural Guide]\u001b[0m \u001b[1mguide:concurrency:fibers\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:fibers\u001b[0m \u001b[90m\u2502\u001b[0m \u001b[90m[Offset +8 lines] \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:threads \u001b[90m\u2502\u001b[0m \u001b[1;37m### Yielding Execution in _process\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:dispatch \u001b[90m\u2502\u001b[0m Pumping spawned fibers cooperatively from main thread:\r\n  \u001b[35m[STD:CLASS]\u001b[0m Channel(T)          \u001b[90m\u2502\u001b[0m   \u001b[1;32mdef _process(delta : Float64)\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m     \u001b[36mFiber.yield\u001b[0m \u001b[90m# Advance background fibers\u001b[0m\r\n  \u001b[32m[CR:CLASS]\u001b[0m WorkerPool          \u001b[90m\u2502\u001b[0m   \u001b[1;32mend\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[1;37m### Awaiting Godot Engine Signals\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m Fibers suspend cooperatively without blocking OS thread:\r\n                                    \u001b[90m\u2502\u001b[0m   \u001b[36mawait timer.timeout\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m   \u001b[36mawait tween.finished\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[90m[PgUp: Top \u2191 \u2502 PgDn: Worker Threads & Channels \u2193]\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
[23.104, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[1;37;48;5;238m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[90m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[36mSearch: [concurrency] (Press '/' to search)\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (6 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;33m[Lapis Architectural Guide]\u001b[0m \u001b[1mguide:concurrency:fibers\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:fibers\u001b[0m \u001b[90m\u2502\u001b[0m \u001b[90m[Offset +16 lines] \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:threads \u001b[90m\u2502\u001b[0m \u001b[1;37m### Background OS Threads & Channels\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:dispatch \u001b[90m\u2502\u001b[0m For CPU-heavy generation (procedural terrain, A* path),\r\n  \u001b[35m[STD:CLASS]\u001b[0m Channel(T)          \u001b[90m\u2502\u001b[0m spawn real OS threads with \u001b[35mGodot::Channel(T)\u001b[0m:\r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m   \u001b[36mchannel = Channel(TerrainMesh).new(capacity: 4)\u001b[0m\r\n  \u001b[32m[CR:CLASS]\u001b[0m WorkerPool          \u001b[90m\u2502\u001b[0m   \u001b[36mThread.new { compute_terrain(channel) }\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[1;37m### Safe Main Thread Dispatch\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m   \u001b[36mGodot.on_main_thread do\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m     mesh_instance.mesh = channel.receive\r\n                                    \u001b[90m\u2502\u001b[0m   \u001b[36mend\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[90m[PgUp: Scroll back up \u2191]\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m \r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
[25.504, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[1;37;48;5;238m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[90m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[36mSearch: [concurrency] (Press '/' to search)\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (6 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;33m[Lapis Architectural Guide]\u001b[0m \u001b[1mguide:concurrency:fibers\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:fibers\u001b[0m \u001b[90m\u2502\u001b[0m \u001b[90mDefined in: docs/d_architecture/a_concurrency.cr:14\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:threads \u001b[90m\u2502\u001b[0m \r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:dispatch \u001b[90m\u2502\u001b[0m \u001b[1mSIGNATURE:\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Channel(T)          \u001b[90m\u2502\u001b[0m   \u001b[1;32;48;5;235mGuide [concurrency]: Fibers & Cooperative Await\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m \r\n  \u001b[32m[CR:CLASS]\u001b[0m WorkerPool          \u001b[90m\u2502\u001b[0m \u001b[1mDESCRIPTION:\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m Comprehensive guide to running Crystal fibers in Godot's\r\n                                    \u001b[90m\u2502\u001b[0m single-threaded scene loop and cooperative yielding.\r\n                                    \u001b[90m\u2502\u001b[0m \r\n                                    \u001b[90m\u2502\u001b[0m \u001b[1;37m### The Three Golden Fiber Invariants\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m 1. Never call blocking sleep on the main thread.\r\n                                    \u001b[90m\u2502\u001b[0m 2. Always cooperatively yield or await engine frames.\r\n                                    \u001b[90m\u2502\u001b[0m 3. Route UI and SceneTree operations to main thread.\r\n                                    \u001b[90m\u2502\u001b[0m \u001b[90m[PgDn: Scroll for Code Examples \u2193]\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
[26.904, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[90m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[1;37;48;5;238m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[36mSearch: [] (Press '/' to search)\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (10 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;35m[Crystal Core Standard Library]\u001b[0m \u001b[1mChannel(T)\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[35m[STD:CLASS]\u001b[0m Channel(T)        \u001b[0m \u001b[90m\u2502\u001b[0m \u001b[90mDefined in: crystal/src/channel.cr:8\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Fiber               \u001b[90m\u2502\u001b[0m \r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m \u001b[1mSIGNATURE:\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Thread              \u001b[90m\u2502\u001b[0m   \u001b[1;32;48;5;235mclass Channel(T)\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Atomic(T)           \u001b[90m\u2502\u001b[0m \r\n  \u001b[35m[STD:METH] \u001b[0m Channel#send        \u001b[90m\u2502\u001b[0m \u001b[1mDESCRIPTION:\u001b[0m\r\n  \u001b[35m[STD:METH] \u001b[0m Channel#receive     \u001b[90m\u2502\u001b[0m Concurrent communication conduit between fibers with M:N\r\n  \u001b[35m[STD:METH] \u001b[0m Mutex#synchronize   \u001b[90m\u2502\u001b[0m cooperative scheduler.\r\n  \u001b[35m[STD:CLASS]\u001b[0m WaitChannel         \u001b[90m\u2502\u001b[0m \r\n  \u001b[35m[STD:CLASS]\u001b[0m ConditionVariable   \u001b[90m\u2502\u001b[0m Cross-thread workers must use buffered channels:\r\n                                    \u001b[90m\u2502\u001b[0m   \u001b[36mChannel(T).new(capacity: 16)\u001b[0m\r\n                                    \u001b[90m\u2502\u001b[0m Avoid unbuffered channels on raw Thread.new to prevent\r\n                                    \u001b[90m\u2502\u001b[0m execution context suspension panics.\r\n                                    \u001b[90m\u2502\u001b[0m \r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
