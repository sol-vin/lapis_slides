[17.664, "o", "\u001b[H \u001b[1;36m:: LAPIS UNIFIED DOCUMENTATION EXPLORER ::\u001b[0m     \u001b[90m\u2502 Indexed: 3,412 symbols\u001b[0m\r\n \u001b[1;37;48;5;238m[ 1: All ]\u001b[0m \u001b[90m[ 2: Godot (GD) ]\u001b[0m \u001b[90m[ 3: Crystal (CR) ]\u001b[0m \u001b[90m[ 4: Guides (DOC) ]\u001b[0m \u001b[90m[ 5: Stdlib (STD) ]\u001b[0m \r\n \u001b[1;33mSearch: [co_]\u001b[0m\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37mSYMBOLS (14 MATCHES)\u001b[0m                 \u001b[90m\u2502\u001b[0m \u001b[1;33m[Godot 4.x Engine API]\u001b[0m \u001b[1mCharacterBody3D#move_and_slide\u001b[0m\r\n  \u001b[36m[GD:CLASS]\u001b[0m CharacterBody3D     \u001b[90m\u2502\u001b[0m \u001b[90mDefined in: godot/scene/3d/physics_body_3d.h:112\u001b[0m\r\n \u001b[1;37;48;5;236m\u25ba \u001b[36m[GD:METH] \u001b[0m move_and_slide    \u001b[0m \u001b[90m\u2502\u001b[0m \u001b[36mInherits: PhysicsBody3D\u001b[0m\r\n  \u001b[36m[GD:PROP] \u001b[0m velocity            \u001b[90m\u2502\u001b[0m \r\n  \u001b[32m[CR:CLASS]\u001b[0m PlayerController    \u001b[90m\u2502\u001b[0m \u001b[1mSIGNATURE:\u001b[0m\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:fibers  \u001b[90m\u2502\u001b[0m   \u001b[1;32;48;5;235mfunc move_and_slide() -> bool\u001b[0m\r\n  \u001b[35m[STD:CLASS]\u001b[0m Channel(T)          \u001b[90m\u2502\u001b[0m \r\n  \u001b[35m[STD:CLASS]\u001b[0m Fiber               \u001b[90m\u2502\u001b[0m \u001b[1mRETURNS:\u001b[0m \u001b[36mbool\u001b[0m (true if collided with body)\r\n  \u001b[35m[STD:CLASS]\u001b[0m Mutex               \u001b[90m\u2502\u001b[0m \r\n  \u001b[32m[CR:STRUCT]\u001b[0m InventoryItem       \u001b[90m\u2502\u001b[0m \u001b[1mDESCRIPTION:\u001b[0m\r\n  \u001b[32m[CR:NODE] \u001b[0m CombatRadar         \u001b[90m\u2502\u001b[0m Moves the body based on velocity. If the body\r\n  \u001b[36m[GD:METH] \u001b[0m is_on_floor         \u001b[90m\u2502\u001b[0m collides with another, it will slide along the\r\n  \u001b[36m[GD:METH] \u001b[0m get_real_velocity   \u001b[90m\u2502\u001b[0m surface rather than stop immediately.\r\n  \u001b[33m[DOC:GUIDE]\u001b[0m concurrency:actor   \u001b[90m\u2502\u001b[0m \r\n  \u001b[35m[STD:CLASS]\u001b[0m Thread              \u001b[90m\u2502\u001b[0m Mutates \u001b[36mvelocity\u001b[0m when colliding with walls/floors.\r\n \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n \u001b[1;37m\u2191/\u2193: Select \u2502 PgUp/PgDn: Scroll Doc \u2502 1-5: Context \u2502 /: Search \u2502 Esc/Q: Exit\u001b[0m"]
