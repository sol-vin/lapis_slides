[1.92, "o", "\u001b[36m\u256d\u2500 Crystal Runtime Inspection: game.dll \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[36m\u2502\u001b[0m Crystal Binary:   \u001b[1;37;42m [\u2713] DETECTED \u001b[0m    Classes: \u001b[1;37m42\u001b[0m   GC Functions: \u001b[1;37m18\u001b[0m            \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m \u001b[90mMain Entrypoint:\u001b[0m  \u001b[36m*Crystal::main\u001b[0m (\u001b[33m0x140001080\u001b[0m) [Boehm GC Active: GC_malloc]     \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m                                                                              \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m \u001b[1;33mDiscovered Crystal Classes (42):\u001b[0m                                             \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u2022 \u001b[1;32mPlayer < CharacterBody3D\u001b[0m           (14 methods, 4 exports, 2 signals)    \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u2022 \u001b[1;32mCombatRadar < Node2D\u001b[0m               (8 methods, 3 exports, 1 signal)      \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u2022 \u001b[1;32mInventory < RefCounted\u001b[0m             (11 methods, 6 exports)               \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u2022 \u001b[1;32mEnemySpawner < Node3D\u001b[0m              (6 methods, 2 exports)                \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u2022 \u001b[36mGodot::Node < Godot::Object\u001b[0m        (28 methods, 12 properties)           \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m   \u001b[90m... and 37 more classes (GC roots registered)\u001b[0m                              \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u