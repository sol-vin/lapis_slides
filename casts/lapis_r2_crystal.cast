[7.87, "o", "\u001b[1;33m// [AST Demangled] Player#_physics_process(delta : Float64) : Nil (0x1400021b0)\u001b[0m\r\n\u001b[1;36m// DISASSEMBLY (x86_64)                 \u2502 PSEUDO-C DECOMPILATION (pdca)\u001b[0m\r\n\u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n0x1400021b0  55          push rbp       \u001b[90m\u2502\u001b[0m \u001b[32mvoid\u001b[0m Player::_physics_process(\u001b[36mf64\u001b[0m delta)\r\n0x1400021b1  4889e5      mov rbp, rsp   \u001b[90m\u2502\u001b[0m {\r\n0x1400021b4  4883ec30    sub rsp, 0x30  \u001b[90m\u2502\u001b[0m     \u001b[90m// Inlined Crystal gravity step\u001b[0m\r\n0x1400021b8  f20f1005    movsd xmm0, d  \u001b[90m\u2502\u001b[0m     this->apply_gravity(delta);\r\n0x1400021c0  e88b0200    call gravity   \u001b[90m\u2502\u001b[0m     \r\n0x1400021c5  e8460100    call slide     \u001b[90m\u2502\u001b[0m     \u001b[36mbool\u001b[0m hit = this->move_and_slide();\r\n0x1400021ca  4885c0      test rax, rax  \u001b[90m\u2502\u001b[0m     \u001b[35mif\u001b[0m (hit) {\r\n0x1400021cd  7405        jz 0x1400021d4 \u001b[90m\u2502\u001b[0m         this->emit_landed();\r\n0x1400021cf  e8920000    call landed    \u001b[90m\u2502\u001b[0m     }\r\n0x1400021d4  4883c430    add rsp, 0x30  \u001b[90m\u2502\u001b[0m }\r\n0x1400021d8  5d          pop rbp        \u001b[90m\u2502\u001b[0m \u001b[90m// Zero runtime overhead \u2022 Direct PtrCall\u001b[0m\r\n0x1400021d9  c3          ret            \u001b[90m\u2502\u001b[0m \u001b[32m\u2714 Verified: 0 Heap Allocations in Loop\u001b[0m\r\n"]
